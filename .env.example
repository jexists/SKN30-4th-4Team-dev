# docker compose 전용 변수 (루트 .env 로 복사해 값을 채우세요 — 커밋 금지).
#
# Vite 는 빌드 시점에 값을 번들에 굽기 때문에 컨테이너 환경변수로는 주입할 수 없습니다.
# compose 가 이 값들을 frontend 이미지의 build args 로 넘깁니다.
# 값은 frontend/.env 에 있는 것과 동일합니다(Supabase 대시보드 → Settings → API).
#
# 비워 두면 화면은 뜨지만 로그인이 비활성화됩니다.

# 로컬 compose 는 프론트(:5173)와 백엔드(:8000)가 다른 포트라 절대주소가 필요합니다.
# 운영(docker-compose.prod.yml)에서는 Caddy 가 같은 도메인의 /api 를 프록시하므로
# 이 값을 쓰지 않습니다(prod 파일이 빈 문자열로 고정).
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 카카오맵 JavaScript 키 (위험 보고서의 위치 정보 카드). 선택 — 비워 두면 지도 대신
# 핀 대체 화면이 뜨고 주소 텍스트는 그대로 보입니다. 자세한 발급·도메인 등록 안내는
# frontend/.env.example 참고.
VITE_KAKAO_MAP_JS_KEY=

# --- 운영(EC2)에서만 사용 — docker-compose.prod.yml ---
# 도메인을 넣으면 Caddy 가 HTTPS 인증서를 자동 발급합니다.
# 도메인이 아직 없다면 ":80" 으로 두고 IP 로 접속해 확인할 수 있지만,
# 그 상태에서는 카카오 로그인이 동작하지 않습니다(OAuth 는 HTTPS 필요).
# SITE_ADDRESS=homeshield.example.com

# 백엔드·OCR 워커 설정은 각각 backend/.env, ocr-worker/.env 를 사용합니다.
