# 로컬은 DATABASE_URL 미설정 시 SQLite 폴백으로 바로 실행됩니다.
# Supabase 연결 시 아래 예시처럼 Postgres 연결 문자열로 교체하세요.
# DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=sqlite:///./app.db

# CORS 허용 origin (쉼표로 구분)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Supabase (인증·파일저장용) — 대시보드에서 pgvector 확장을 켜세요.
# SUPABASE_URL 은 비대칭키(JWKS) 토큰 검증 시 공개키 출처로도 쓰입니다
#   ({SUPABASE_URL}/auth/v1/.well-known/jwks.json). 비밀값이 아니며 프론트의
#   VITE_SUPABASE_URL 과 같은 값입니다.
SUPABASE_URL=
SUPABASE_KEY=

# --- Supabase Auth JWT 검증 ---
# 백엔드는 프론트가 보낸 액세스 토큰을 '검증만' 합니다. 서명 방식에 따라 둘 중 하나면 됩니다:
#  * 비대칭키(ES256/RS256 — 최근 Supabase 프로젝트 기본): 위 SUPABASE_URL 만 있으면 JWKS 로
#    검증합니다. 아래 SUPABASE_JWT_SECRET 은 필요 없습니다.
#  * 대칭키(HS256 — 레거시): 아래 시크릿이 필요합니다 (Settings → API → JWT Settings → JWT Secret).
# 둘 다 없으면 보호 엔드포인트는 항상 실패합니다(fail-closed). 어느 방식으로 검증하는지는
# 서버 기동 로그의 "JWT 검증 모드: ..." 한 줄로 확인할 수 있습니다.
SUPABASE_JWT_SECRET=

# exp 검사 시 허용할 시계 오차(초). 기본 60.
# 0 으로 두면 재부팅 직후처럼 PC 시계가 조금 밀린 사용자가 멀쩡한 토큰으로도 401 을 받습니다.
# JWT_LEEWAY_SECONDS=60
