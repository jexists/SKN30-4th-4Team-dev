# 설명은 README.md 의 "환경변수" 참고. 실제 값은 .env 에 (커밋 금지)

# 런타임(API·ORM). Supabase Dashboard → Connect → **Transaction pooler** 의 URI 를 그대로
# 복사한다(보통 :6543). Session pooler(:5432) 는 클라이언트 수가 Pool Size(기본 15)로
# 제한돼, 팀원 여러 명이 각자 로컬 서버를 띄우면 EMAXCONNSESSION 이 난다.
# 포트만 바꾸지 말고 Dashboard 가 주는 전체 URI 를 쓸 것.
APP_DB_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:6543/postgres

# RAG 벡터 스토어. 앱 DB 와 같은 Supabase 면 비워 둔다(APP_DB_URL 재사용).
RAG_DB_URL=

# 색인·DDL 전용(test/ingest_kure.py). 런타임과 분리한다 — transaction pooler 는 세션 단위
# 보장이 없어 DDL·대량 배치에 부적합하다. Dashboard 의 Direct connection 권장,
# IPv6 가 안 되면 Session pooler(:5432). 가리키는 DB 는 런타임과 같아야 한다.
INGEST_DATABASE_URL=

# 커넥션 풀 예산 — 프로세스당 최대 = (DB_POOL_SIZE + DB_MAX_OVERFLOW) + RAG_POOL_MAX_SIZE.
# 기본 3+2+2=7. 값을 올리기 전에 (백엔드 프로세스 수 × 상한) 을 반드시 계산할 것.
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=2
# DB_POOL_TIMEOUT_SECONDS=10
# DB_POOL_RECYCLE_SECONDS=1800
# DB_CONNECT_TIMEOUT_SECONDS=10
# RAG_POOL_MAX_SIZE=2

WARMUP_ON_STARTUP=true
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=

# 프로필 사진 업로드(Supabase Storage). service_role 키 필요 — 대시보드 → Settings → API →
# service_role(비밀 유지). 아바타 버킷은 미리 public 으로 만들어 둘 것(기본 이름 avatars).
SUPABASE_SERVICE_ROLE_KEY=
# AVATAR_BUCKET=avatars
# AVATAR_MAX_FILE_MB=5
# 분석 입력은 백엔드끼리 공유하는 private 버킷에만 저장한다. public으로 만들지 말 것.
# ANALYSIS_INPUT_BUCKET=analysis-inputs
# ANALYSIS_STORAGE_TIMEOUT_SECONDS=60

# 분석 작업 큐 워커. analysis_job 테이블을 큐로 삼아 QUEUED 를 선점(claim)해 처리한다.
#
# **켜기 전에 반드시 읽을 것** — claim 에는 사용자·호스트 스코프가 없다
# (repositories/analysis_job.py claim_next 는 status=QUEUED 만 보고 가장 오래된 것을 집는다).
# 팀이 같은 Supabase DB 를 쓰므로, 켜 둔 인스턴스는 **누가 업로드했든** 남의 작업을 가져간다.
# 내가 올린 계약서가 팀원 노트북에서 처리돼, 그쪽 OCR_WORKER_URL·언어팩·코드 버전에 따라
# 503/422 로 실패하는 일이 실제로 있었다. 로컬 개발은 false 로 두는 것이 기본이다.
ANALYSIS_WORKER_ENABLED=false
# ANALYSIS_WORKER_CONCURRENCY=1
# ANALYSIS_POLL_INTERVAL_SECONDS=2.0
# ANALYSIS_JOB_LEASE_SECONDS=1800
# ANALYSIS_JOB_MAX_ATTEMPTS=3

OPENAI_API_KEY=

# 사용자 계약서 OCR/마스킹 worker (모델은 backend 프로세스가 직접 로드하지 않음)
OCR_WORKER_URL=http://localhost:8100
OCR_WORKER_API_KEY=
OCR_WORKER_TIMEOUT_SECONDS=10
OCR_WORKER_PROCESS_TIMEOUT_SECONDS=1200

# 1차 워커가 **인프라 사유로** 실패했을 때만 넘어가는 2차 워커.
# 예: 1차 = RunPod GPU(paddle_vl), 2차 = EC2 CPU(tesseract, Dockerfile.tesseract 로 빌드).
# 비우면 폴백 없음 = 기존 동작. 켜기 전에 아래 둘을 확인할 것.
#
#  1) 인식 품질이 다르다. tesseract 폴백은 한글 자간이 분해돼 나와서 이름·계좌 마스킹이
#     걸리지 않는다(마스킹은 워커 안에서 일어난다). 폴백은 조용히 일어나므로,
#     어느 엔진이 처리했는지는 GET /api/v1/documents/ocr-health 의 target·provider 로 본다.
#  2) 2차 워커는 별도 호스트다. 평문 HTTP 로 두면 계약서 원본이 그대로 나간다 —
#     TLS 를 앞에 두고, OCR_FALLBACK_WORKER_API_KEY 와 보안그룹으로 접근을 제한할 것.
OCR_FALLBACK_WORKER_URL=
OCR_FALLBACK_WORKER_API_KEY=
# 1차 타임아웃을 다 쓴 뒤 시작하므로, 합(1200+300)이 ANALYSIS_JOB_LEASE_SECONDS(1800)보다
# 작아야 한다. 넘으면 아직 도는 작업을 좀비로 오인해 재큐잉하고 같은 문서를 두 번 처리한다.
OCR_FALLBACK_PROCESS_TIMEOUT_SECONDS=300
CONTRACT_MAX_FILES=10
CONTRACT_MAX_FILE_MB=20
CONTRACT_ANALYSIS_MODEL=gpt-4.1-mini
CONTRACT_ANALYSIS_MAX_CHARS=50000
CONTRACT_ANALYSIS_MAX_TOTAL_CHARS=150000
CONTRACT_ANALYSIS_LOCAL_FALLBACK=true
