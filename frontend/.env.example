# 설명은 README.md 의 "환경변수" 참고. 실제 값은 .env 에 (커밋 금지)
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 카카오맵 (위험 보고서의 위치 정보 카드). 비워 두면 지도 대신 핀 대체 화면이 뜨고
# 주소 텍스트는 그대로 보입니다 — 없어도 화면은 정상 동작합니다.
# 카카오 개발자센터 → 내 애플리케이션 → 앱 키 → "JavaScript 키" (REST API 키가 아닙니다).
# ⚠️ 플랫폼 → Web 에 http://localhost:5173 과 운영 도메인을 등록해야 동작합니다.
#    미등록이면 키가 맞아도 SDK 가 로드되지 않습니다.
VITE_KAKAO_MAP_JS_KEY=
