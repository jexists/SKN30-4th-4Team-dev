# 비우면 개발 서버(vite)가 /api 요청을 http://localhost:8000 으로 프록시합니다. (개발 권장)
# 값을 넣으면 브라우저가 그 주소로 백엔드를 직접 호출합니다 (백엔드 CORS 허용 필요).
VITE_API_BASE_URL=

# Supabase Auth (회원가입·로그인). 대시보드 → Settings → API 에서 복사.
#   VITE_SUPABASE_URL      = Project URL (예: https://xxxx.supabase.co)
#   VITE_SUPABASE_ANON_KEY = anon public key (공개키라 프론트 노출 OK)
# 비어 있으면 회원가입/로그인이 비활성(안내 문구 표시)됩니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 서비스 이름 등 환경과 무관한 값은 여기가 아니라 src/config/env.ts 의 BRAND 에서 관리합니다.
