OCR_MODEL_NAME=PaddlePaddle/PaddleOCR-VL-1.6
OCR_PIPELINE_VERSION=v1.6
OCR_ENGINE=transformers
OCR_DEVICE=cpu

OCR_VL_MODEL_DIR=/models/paddleocr-vl-1.6
# OCR_LAYOUT_MODEL_DIR=/models/layout-detection
# OCR_ORIENTATION_MODEL_DIR=/models/doc-orientation
# OCR_UNWARP_MODEL_DIR=/models/doc-unwarping

# Apple Silicon + MLX-VLM 서버 사용 시
# OCR_VL_BACKEND=mlx-vlm-server
# OCR_VL_SERVER_URL=http://host.docker.internal:8111/
# OCR_VL_API_MODEL_NAME=/models/paddleocr-vl-1.6

OCR_USE_ORIENTATION=true
OCR_USE_UNWARPING=false
OCR_USE_SEAL_RECOGNITION=true
OCR_LAYOUT_SHAPE_MODE=poly
OCR_MAX_FILE_MB=20
OCR_MAX_PAGES=20
OCR_RENDER_DPI=250
OCR_MASK_MARGIN_PX=4
