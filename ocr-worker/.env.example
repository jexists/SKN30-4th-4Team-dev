# GPU 없는 개발 환경에서는 tesseract 로 둔다. 마스킹·재검증 파이프라인은 동일하고
# 인식 품질만 달라진다. paddle_vl 은 GPU(또는 Apple Silicon + MLX)에서만 실용적이다.
OCR_MODEL_NAME=PaddlePaddle/PaddleOCR-VL-1.6
OCR_PROVIDER=paddle_vl
OCR_PIPELINE_VERSION=v1.6
OCR_ENGINE=transformers
OCR_DEVICE=cpu

# 비우면 PaddleOCR가 v1.6 공식 모델을 자동으로 내려받습니다.
# OCR_VL_MODEL_DIR=/workspace/models/paddleocr-vl-1.6
# OCR_LAYOUT_MODEL_DIR=/models/layout-detection
# OCR_ORIENTATION_MODEL_DIR=/models/doc-orientation
# OCR_UNWARP_MODEL_DIR=/models/doc-unwarping

# Apple Silicon + MLX-VLM 서버 사용 시
# OCR_VL_BACKEND=mlx-vlm-server
# OCR_VL_SERVER_URL=http://host.docker.internal:8111/
# OCR_VL_API_MODEL_NAME=/models/paddleocr-vl-1.6

OCR_USE_ORIENTATION=true
OCR_USE_LAYOUT_DETECTION=true
OCR_USE_UNWARPING=false
OCR_USE_SEAL_RECOGNITION=true
OCR_LAYOUT_SHAPE_MODE=poly
OCR_MAX_FILE_MB=20
OCR_MAX_PAGES=20
OCR_RENDER_DPI=250
OCR_MAX_IMAGE_LONG_EDGE=3200
OCR_AUTO_CROP=true
OCR_CROP_THRESHOLD=245
OCR_CROP_PADDING_PX=24
OCR_AUTO_CONTRAST=true
OCR_MASK_MARGIN_PX=4
OCR_WORKER_API_KEY=
# Queue-based Serverless가 signed URL을 받을 때 정확히 일치해야 하는 Supabase 호스트
# OCR_SOURCE_ALLOWED_HOST=your-project-ref.supabase.co
OCR_SOURCE_ALLOWED_HOST=
OCR_SOURCE_DOWNLOAD_TIMEOUT_SECONDS=30
OCR_TESSERACT_LANG=kor+eng
OCR_TESSERACT_PSM=6
