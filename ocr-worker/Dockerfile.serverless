FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/workspace \
    HF_HOME=/workspace/.cache/huggingface \
    OCR_PROVIDER=paddle_vl \
    OCR_PIPELINE_VERSION=v1.6 \
    OCR_ENGINE=transformers \
    OCR_DEVICE=gpu:0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates libgl1 libglib2.0-0 python3 python3-dev python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-runpod.txt ./
RUN python3 -m pip install --break-system-packages \
        paddlepaddle-gpu==3.3.0 \
        --index-url https://www.paddlepaddle.org.cn/packages/stable/cu126/ \
    && python3 -m pip install --break-system-packages -r requirements-runpod.txt

ENV CC=/usr/bin/gcc CXX=/usr/bin/g++
COPY app ./app

CMD ["python3", "-u", "-m", "app.serverless_handler"]
